// ============================================================================
// 缩放输出着色器 (Scale Shader)
// ============================================================================
//
// 功能: 将游戏画面(320x182)等比例缩放输出到窗口
//
// wgpu/WGSL 教学要点:
// 1. 后处理Pass: 在游戏渲染完成后，将结果缩放到窗口
// 2. 全屏四边形: 不使用顶点缓冲区，直接在着色器中生成顶点
// 3. 保持宽高比: 通过scale和offset参数实现letterbox/pillarbox效果
//
// 渲染流程:
// ┌─────────────────────────────────────────────────────────────────────┐
// │ 游戏渲染 (320x182)                                                   │
// │   ↓                                                                 │
// │ render_texture (内部纹理)                                            │
// │   ↓                                                                 │
// │ 缩放着色器 (本文件)                                                  │
// │   ↓                                                                 │
// │ 窗口Surface (任意尺寸，等比例缩放)                                   │
// └─────────────────────────────────────────────────────────────────────┘
//
// 为什么需要这个着色器?
// - 游戏使用固定的320x182分辨率（复古像素风格）
// - 窗口大小可变，需要保持宽高比缩放
// - 使用Nearest采样保持像素清晰度
// ============================================================================

// ----------------------------------------------------------------------------
// Uniform 结构
// 
// scale: 缩放比例，控制画面在窗口中的大小
// offset: 偏移量，控制画面在窗口中的位置（用于居中）
// ----------------------------------------------------------------------------

struct ScaleUniform {
    scale: vec2<f32>,   // NDC空间的缩放比例
    offset: vec2<f32>,  // NDC空间的偏移量
}

// 绑定组: 渲染纹理 + 采样器 + 缩放参数
@group(0) @binding(0) var render_texture: texture_2d<f32>;
@group(0) @binding(1) var tex_sampler: sampler;
@group(0) @binding(2) var<uniform> scale_params: ScaleUniform;

struct VertexOutput {
    @builtin(position) clip_position: vec4<f32>,
    @location(0) uv: vec2<f32>,
}

// ============================================================================
// 顶点着色器
// 
// wgpu教学: 全屏四边形技巧
// - 不需要顶点缓冲区，直接在着色器中定义顶点
// - 使用vertex_index(0-5)索引预定义的位置数组
// - 这是后处理着色器的常见模式
// ============================================================================

@vertex
fn vs_main(@builtin(vertex_index) vertex_index: u32) -> VertexOutput {
    // 全屏四边形顶点（覆盖整个NDC空间[-1,1]）
    var positions = array<vec2<f32>, 6>(
        vec2<f32>(-1.0, -1.0), vec2<f32>(1.0, -1.0), vec2<f32>(-1.0, 1.0),
        vec2<f32>(1.0, -1.0), vec2<f32>(1.0, 1.0), vec2<f32>(-1.0, 1.0)
    );
    let pos = positions[vertex_index];
    
    var output: VertexOutput;
    
    // 应用缩放和偏移（实现保持宽高比的居中显示）
    output.clip_position = vec4<f32>(pos * scale_params.scale + scale_params.offset, 0.0, 1.0);
    
    // 计算UV坐标（从NDC空间[-1,1]映射到UV空间[0,1]）
    output.uv = (pos + 1.0) * 0.5;
    output.uv.y = 1.0 - output.uv.y;  // Y轴翻转（纹理坐标Y轴向下）
    
    return output;
}

// ============================================================================
// 片段着色器
// 
// 非常简单: 直接采样渲染纹理
// 使用Nearest采样器保持像素风格的清晰边缘
// ============================================================================

@fragment
fn fs_main(in: VertexOutput) -> @location(0) vec4<f32> {
    return textureSample(render_texture, tex_sampler, in.uv);
}
